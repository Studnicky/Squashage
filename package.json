{
  "name": "@studnicky/squashage",
  "version": "0.7.1",
  "description": "Graph reconstitution pipeline; squashes classified JSON records into deterministic RDF (Turtle, TriG, JSON-LD, N-Triples, N-Quads).",
  "type": "module",
  "bin": {
    "squashage": "./dist/cli/dagonizerCli.js"
  },
  "exports": {
    ".": "./dist/SquashageRun.js",
    "./SquashageRun": "./dist/SquashageRun.js",
    "./config/ConfigClamp": "./dist/config/ConfigClamp.js",
    "./Logger": "./dist/modules/logger/logger.js",
    "./errors/BaseError": "./dist/errors/BaseError.js",
    "./errors/ExternalSchemaError": "./dist/errors/ExternalSchemaError.js",
    "./errors/QuarantineError": "./dist/errors/QuarantineError.js",
    "./errors/OutputConfigError": "./dist/errors/OutputConfigError.js",
    "./errors/FileOutputError": "./dist/errors/FileOutputError.js",
    "./errors/SquashageConfigError": "./dist/errors/SquashageConfigError.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/Squashage.git"
  },
  "bugs": {
    "url": "https://github.com/Studnicky/Squashage/issues"
  },
  "homepage": "https://studnicky.github.io/Squashage/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmit false && npm run build:assets",
    "build:assets": "node scripts/copy-dag-assets.mjs",
    "author:dags": "node --import tsx scripts/author-dags.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/dagonizerCli.js",
    "postinstall": "bash scripts/install-hooks.sh && node scripts/create-type-stubs.js",
    "prepare": "bash scripts/install-hooks.sh",
    "viz:fingerprints": "tsx scripts/build-fingerprints.ts",
    "viz:refresh-vendor": "node scripts/refresh-viz-vendor.js",
    "docs:render-dags": "node --import tsx scripts/render-dags.ts",
    "docs:dev": "npm run docs:render-dags && vitepress dev docs",
    "docs:build": "npm run docs:render-dags && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/dataset": "^2.0.2",
    "@rdfjs/namespace": "^2.0.1",
    "@rdfjs/types": "^2.0.1",
    "@studnicky/dagonizer": "^0.25.0",
    "@studnicky/json-tology": "^0.26.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.3",
    "json-schema-to-ts": "^3.1.1",
    "jsonld": "^9.0.0",
    "n3": "^2.0.3",
    "rdf-canonize": "^5.0.0",
    "rdf-validate-shacl": "^0.6.5",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsonld": "^1.5.15",
    "@types/n3": "^1.26.1",
    "@types/node": "^25.6.0",
    "@types/rdfjs__data-model": "^2.0.9",
    "@types/rdfjs__dataset": "^2.0.7",
    "@xmldom/xmldom": "^0.9.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-types": "^0.24.8",
    "mermaid": "^11.15.0",
    "sigma": "^3.0.3",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "sideEffects": false,
  "author": "a.j.studnicky@gmail.com",
  "license": "MIT",
  "squashage": {
    "seo": {
      "googleSiteVerification": "",
      "bingSiteVerification": "",
      "twitterHandle": ""
    }
  }
}
