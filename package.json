{
  "name": "squashage",
  "version": "0.2.1",
  "description": "Graph reconstitution pipeline — squashes classified JSON records into deterministic RDF (Turtle, TriG, JSON-LD, N-Triples, N-Quads).",
  "type": "module",
  "bin": {
    "squashage": "./dist/cli/cli.js"
  },
  "exports": {
    "./config/ConfigClamp": "./dist/config/ConfigClamp.js",
    "./Pipeline": "./dist/pipeline/Pipeline.js",
    "./ConcurrentPipeline": "./dist/pipeline/ConcurrentPipeline.js",
    "./Logger": "./dist/modules/logger/logger.js",
    "./errors/BaseError": "./dist/errors/BaseError.js",
    "./errors/HttpError": "./dist/errors/HttpError.js",
    "./errors/ExternalSchemaError": "./dist/errors/ExternalSchemaError.js",
    "./errors/OutputConfigError": "./dist/errors/OutputConfigError.js",
    "./errors/FileOutputError": "./dist/errors/FileOutputError.js",
    "./errors/SquashageConfigError": "./dist/errors/SquashageConfigError.js",
    "./registry/TaskRegistry": "./dist/registry/TaskRegistry.js",
    "./registry/PipelineState": "./dist/registry/PipelineState.js"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc --noEmit false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "test:unit": "node --import tsx --test 'tests/unit/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "dev": "node --watch dist/cli/cli.js",
    "postinstall": "bash scripts/install-hooks.sh && node scripts/create-type-stubs.js",
    "prepare": "bash scripts/install-hooks.sh",
    "test:integration": "node --import tsx --test 'tests/integration/**/*.test.ts'",
    "test:e2e": "node --import tsx --test 'tests/e2e/**/*.test.ts'",
    "viz:demo": "node --import tsx scripts/build-aonprd-demo.ts",
    "viz:refresh-vendor": "node scripts/refresh-viz-vendor.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@rdfjs/data-model": "^2.1.1",
    "@rdfjs/dataset": "^2.0.2",
    "@rdfjs/namespace": "^2.0.1",
    "@rdfjs/types": "^2.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.0.0",
    "json-schema-to-ts": "^3.1.1",
    "jsonld": "^9.0.0",
    "n3": "^2.0.3",
    "rdf-canonize": "^5.0.0",
    "rdf-validate-shacl": "^0.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/rdfjs__data-model": "^2.0.9",
    "@types/rdfjs__dataset": "^2.0.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "globals": "^15.0.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-types": "^0.24.8",
    "sigma": "^3.0.3",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.59.2",
    "vitepress": "^1.6.4",
    "vue": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "sideEffects": false,
  "author": "a.j.studnicky@gmail.com",
  "license": "UNLICENSED"
}
