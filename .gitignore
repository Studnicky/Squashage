# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

# output and reports
reports
data

# Build / scrape output
dist/
# TypeScript incremental build info
*.tsbuildinfo
# Top-level output/ directory (run artifacts); src/output/ is source code and is tracked.
/output/

# Pipeline + viz outputs (gigabytes of N-Quads + per-class JSON chunks).
# Reproduce by re-running the pipeline + viz CLI.
/graphs/
/graphs.partial/
/viz/
/plugins/*/schemas/inferred/
/plugins/*/schemas/primitives/
/plugins/*/schemas/objects/

# Scratch debug scripts (one-off conversions, ad-hoc tests).
/scripts/test-*.mjs
# Example output files are committed as documentation of expected output shape
!examples/**/output/
!examples/**/output/**

# Compiled plugin outputs (built from plugins/**/*.ts via tsconfig.plugins.json)
plugins/**/*.js
plugins/**/*.js.map
plugins/**/*.d.ts

# Compiled artifacts must never land in src/ (only in dist/)
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
# Hand-written ambient shims are committed (they carry the -shim suffix)
!src/**/*-shim.d.ts

# User's local configs — never committed.
# Only canonical `squashage.config*.example.json` files are tracked.
squashage.config*.json
!squashage.config*.example.json

# Harness / tooling state
.claude/
.enginseer/

# OS
.DS_Store
.orchestration/
.env

# Target-specific plugin source — shipped as examples in v1, not the beta.
# Anchored to repo root so first-party silo plugins under
# `src/classification/plugins/` (and their tests) stay tracked.
/plugins/

# Demo build artifacts (graphs/ subdirectory from viz:demo script)
docs/examples/aonprd/graphs/
docs/public/examples/aonprd/graphs/
docs/.vitepress/dist/
docs/.vitepress/cache/

# Plans are local-only working documents; not published
docs/plans/

# Session triage / plan artifacts (working documents)
.triage-*.md
.plan-*.md

# Heap profiling artifacts
*.heapsnapshot
*.heapprofile
