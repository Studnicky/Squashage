{
  "name": "your-target",
  "input": {
    "basePath": "./output/your-target",
    "format": "json"
  },
  "output": {
    "kind": "file",
    "path": "./graphs/your-target.trig",
    "mode": "dataset"
  },
  "concurrency": 4,
  "graphs": {
    "default": "https://example.com/graph/default"
  },
  "classification": {
    "source": true,
    "structural": [
      {
        "className": "YourClass",
        "priority": 10,
        "predicate": {
          "path": "/_type",
          "equals": "your-type"
        },
        "reasons": [
          "_type=your-type (structural)"
        ]
      }
    ],
    "rules": [
      {
        "className": "YourClass",
        "priority": 20,
        "predicate": {
          "all": [
            {
              "path": "/_type",
              "equals": "your-type"
            },
            {
              "path": "/id",
              "exists": true
            }
          ]
        },
        "reasons": [
          "_type=your-type",
          "id present"
        ]
      }
    ],
    "ontology": {
      "classes": {
        "YourClass": "https://example.com/class/YourClass"
      }
    },
    "conflict": {
      "onConflict": "quarantine",
      "evidence": true
    }
  },
  "quarantine": {
    "dir": "./graphs/quarantine/your-target"
  }
}
