# GitHub Packages registry routes (auth token lives in ~/.npmrc, never committed)
@studnicky:registry=https://npm.pkg.github.com
@noocodex:registry=https://npm.pkg.github.com

# @studnicky/json-tology peers on eyereasoner, which still peers on @rdfjs/types@^1
# while this project (and json-tology itself) use @rdfjs/types@^2 — a benign upstream
# peer mismatch. Resolve it consistently across local + CI so `npm ci` matches the lock.
legacy-peer-deps=true
