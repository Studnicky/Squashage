  "@id": "urn:noocodex:dag:squashage:refine-one",
  "@type": "DAG",
  "name": "squashage:refine-one",
  "version": "1.0",
  "entrypoint": "refine-init",
  "nodes": [
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/refine-init",
      "@type": "SingleNode",
      "name": "refine-init",
      "node": "refine-init",
      "outputs": {
        "done": "read-draft"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/read-draft",
      "@type": "SingleNode",
      "name": "read-draft",
      "node": "read-draft",
      "outputs": {
        "loaded": "read-refinement",
        "error": "refine-summary-collect"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/read-refinement",
      "@type": "SingleNode",
      "name": "read-refinement",
      "node": "read-refinement",
      "outputs": {
        "loaded": "apply-refinement",
        "missing": "refinement-missing-warn",
        "error": "refine-summary-collect"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/apply-refinement",
      "@type": "SingleNode",
      "name": "apply-refinement",
      "node": "apply-refinement",
      "outputs": {
        "applied": "write-final",
        "error": "refine-summary-collect"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/refinement-missing-warn",
      "@type": "SingleNode",
      "name": "refinement-missing-warn",
      "node": "refinement-missing-warn",
      "outputs": {
        "done": "write-final"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/write-final",
      "@type": "SingleNode",
      "name": "write-final",
      "node": "write-final",
      "outputs": {
        "written": "refine-summary-collect"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/refine-summary-collect",
      "@type": "SingleNode",
      "name": "refine-summary-collect",
      "node": "refine-summary-collect",
      "outputs": {
        "done": "end"
      }
    },
    {
      "@id": "urn:noocodex:dag:squashage:refine-one/node/end",
      "@type": "TerminalNode",
      "name": "end",
      "outcome": "completed"
    }
  ]
}