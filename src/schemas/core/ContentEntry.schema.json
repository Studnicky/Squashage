{
  "$id": "https://noocodec.dev/squashage/core/ContentEntry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentEntry",
  "type": "object",
  "allOf": [
    { "$ref": "https://noocodec.dev/squashage/core/NamedThing.schema.json" }
  ],
  "properties": {
