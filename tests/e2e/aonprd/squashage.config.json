{
  "input": {
    "basePath": "./input",
    "format": "json"
  },
  "targets": {
    "aonprd": {
      "input": "./input",
      "concurrency": 2,
      "pipeline": [
        "json:read",
        "classify:source",
        "classify:structural",
        "classify:rules",
        "classify:schema",
        "classify:ontology",
        "classify:conflict",
        "aonprd:squash",
        "rdfjs:finalize"
      ],
      "classification": {
        "source": true,
        "structural": [
          {
            "className": "feat",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "feat"
            },
            "reasons": [
              "_type=feat (structural)"
            ]
          },
          {
            "className": "feat",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "featspell"
            },
            "reasons": [
              "_type=featspell matches feat (structural)"
            ]
          },
          {
            "className": "spell",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "spell"
            },
            "reasons": [
              "_type=spell (structural)"
            ]
          },
          {
            "className": "spell",
            "priority": 10,
            "predicate": {
              "path": "/traditions",
              "type": "array"
            },
            "reasons": [
              "traditions array present (structural)"
            ]
          },
          {
            "className": "monster",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "monster"
            },
            "reasons": [
              "_type=monster (structural)"
            ]
          },
          {
            "className": "action",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "action"
            },
            "reasons": [
              "_type=action (structural)"
            ]
          },
          {
            "className": "equipment",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "equipment"
            },
            "reasons": [
              "_type=equipment (structural)"
            ]
          },
          {
            "className": "weapon",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "weapon"
            },
            "reasons": [
              "_type=weapon (structural)"
            ]
          },
          {
            "className": "armor",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "armor"
            },
            "reasons": [
              "_type=armor (structural)"
            ]
          },
          {
            "className": "shield",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "shield"
            },
            "reasons": [
              "_type=shield (structural)"
            ]
          },
          {
            "className": "ancestry",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "ancestry"
            },
            "reasons": [
              "_type=ancestry (structural)"
            ]
          },
          {
            "className": "class",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "class"
            },
            "reasons": [
              "_type=class (structural)"
            ]
          },
          {
            "className": "background",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "background"
            },
            "reasons": [
              "_type=background (structural)"
            ]
          },
          {
            "className": "condition",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "condition"
            },
            "reasons": [
              "_type=condition (structural)"
            ]
          },
          {
            "className": "trait",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "trait"
            },
            "reasons": [
              "_type=trait (structural)"
            ]
          },
          {
            "className": "hazard",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "hazard"
            },
            "reasons": [
              "_type=hazard (structural)"
            ]
          },
          {
            "className": "generic",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "generic"
            },
            "reasons": [
              "_type=generic (structural)"
            ]
          },
          {
            "className": "unknown",
            "priority": 10,
            "predicate": {
              "path": "/_type",
              "equals": "unknown"
            },
            "reasons": [
              "_type=unknown (structural)"
            ]
          }
        ],
        "rules": [
          {
            "className": "feat",
            "priority": 20,
            "predicate": {
              "all": [
                {
                  "path": "/_type",
                  "equals": "feat"
                },
                {
                  "path": "/level",
                  "type": "number"
                }
              ]
            },
            "reasons": [
              "_type=feat",
              "level present"
            ]
          },
          {
            "className": "spell",
            "priority": 20,
            "predicate": {
              "all": [
                {
                  "path": "/_type",
                  "equals": "spell"
                },
                {
                  "path": "/level",
                  "type": "number"
                }
              ]
            },
            "reasons": [
              "_type=spell",
              "level present"
            ]
          }
        ],
        "schemas": [
          {
            "className": "feat",
            "priority": 30,
            "schemaPath": "./schemas/feat.schema.json"
          },
          {
            "className": "spell",
            "priority": 30,
            "schemaPath": "./schemas/spell.schema.json"
          },
          {
            "className": "monster",
            "priority": 30,
            "schemaPath": "./schemas/monster.schema.json"
          },
          {
            "className": "action",
            "priority": 30,
            "schemaPath": "./schemas/action.schema.json"
          },
          {
            "className": "equipment",
            "priority": 30,
            "schemaPath": "./schemas/equipment.schema.json"
          }
        ],
        "ontology": {
          "classes": {
            "feat": "https://squashage.dev/vocabulary/aonprd#Feat",
            "spell": "https://squashage.dev/vocabulary/aonprd#Spell",
            "monster": "https://squashage.dev/vocabulary/aonprd#Monster",
            "action": "https://squashage.dev/vocabulary/aonprd#Action",
            "equipment": "https://squashage.dev/vocabulary/aonprd#Equipment",
            "weapon": "https://squashage.dev/vocabulary/aonprd#Weapon",
            "armor": "https://squashage.dev/vocabulary/aonprd#Armor",
            "shield": "https://squashage.dev/vocabulary/aonprd#Shield",
            "ancestry": "https://squashage.dev/vocabulary/aonprd#Ancestry",
            "class": "https://squashage.dev/vocabulary/aonprd#Class",
            "background": "https://squashage.dev/vocabulary/aonprd#Background",
            "condition": "https://squashage.dev/vocabulary/aonprd#Condition",
            "trait": "https://squashage.dev/vocabulary/aonprd#Trait",
            "hazard": "https://squashage.dev/vocabulary/aonprd#Hazard",
            "generic": "https://squashage.dev/vocabulary/aonprd#Generic",
            "unknown": "https://squashage.dev/vocabulary/aonprd#Unknown"
          }
        },
        "conflict": {
          "onConflict": "quarantine",
          "onUnknown": "quarantine",
          "evidence": true
        }
      },
      "ontology": {
        "engine": "json-tology",
        "baseIRI": "https://squashage.dev/vocabulary/aonprd",
        "schemas": [
          { "schemaPath": "./schemas/feat.schema.json" },
          { "schemaPath": "./schemas/spell.schema.json" },
          { "schemaPath": "./schemas/monster.schema.json" },
          { "schemaPath": "./schemas/action.schema.json" },
          { "schemaPath": "./schemas/equipment.schema.json" }
        ],
        "emit": {
          "tbox":  "graphs/aonprd/ontology.ttl",
          "shacl": "graphs/aonprd/shapes.ttl"
        }
      },
      "output": {
        "kind": "file",
        "path": "./out/aonprd.jsonld",
        "mode": "dataset",
        "canonicalize": true
      }
    }
  }
}
