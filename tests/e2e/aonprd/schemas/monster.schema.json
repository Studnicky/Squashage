{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squashage.dev/schemas/aonprd/monster",
  "title": "Monster",
  "type": "object",
  "additionalProperties": true,
  "required": ["_type"],
  "properties": {
    "_type": { "type": "string", "const": "monster" },
    "url": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "level": { "type": "integer", "minimum": -1, "maximum": 25 },
    "rarity": { "type": "string" },
    "traits": { "type": "array", "items": { "type": "string" } },
    "size": { "type": "string" },
    "alignment": { "type": ["string", "null"] },
    "description_text": { "type": "string" }
  }
}
