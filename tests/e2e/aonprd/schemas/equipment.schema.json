{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squashage.dev/schemas/aonprd/equipment",
  "title": "Equipment",
  "type": "object",
  "additionalProperties": true,
  "required": ["_type"],
  "properties": {
    "_type": { "type": "string", "const": "equipment" },
    "url": { "type": "string", "format": "uri" },
    "name": { "type": "string" },
    "item_level": { "type": ["integer", "null"], "minimum": 0, "maximum": 25 },
    "rarity": { "type": "string" },
    "traits": { "type": "array", "items": { "type": "string" } },
    "bulk": {},
    "description_text": { "type": "string" }
  }
}
